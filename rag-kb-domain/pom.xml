<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kniv.ragkb</groupId>
        <artifactId>rag-kb-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rag-kb-domain</artifactId>
    <name>rag-kb-domain</name>
    <description>领域模型：实体(Entity)、请求/响应对象(DTO/VO)、枚举</description>

    <dependencies>
        <dependency>
            <groupId>com.kniv.ragkb</groupId>
            <artifactId>rag-kb-common</artifactId>
        </dependency>
        <!-- 用完整 starter 而非只带注解的 mybatis-plus-annotation：
             自定义 TypeHandler 需要 org.apache.ibatis.type.BaseTypeHandler（在 mybatis 核心包），
             只引注解包拿不到它。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
