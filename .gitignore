# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# 运行时数据（凭据、上传文档、日志）
data/

# 日志
*.log

# 系统
.DS_Store
Thumbs.db

# 探针脚本运行时的临时 SQL（每次运行重新生成，不是输入）
tools/_*.sql

# Python 探针的字节码缓存
tools/__pycache__/
__pycache__/
tools/_chk.sql
tools/_ruler_*.sql
tools/_lj.sql
tools/_tk.sql
tools/_th.sql
tools/_mmr.sql
tools/_tq.sql
tools/_mh.sql
tools/_fresh.sql
tools/eval/_runs/
__pycache__/
*.pyc
tools/eval/_runs/
data/_nothink.log

# 逐块判定探针的缓存（可重生成，21 题 × ~10 块）
tools/eval/_cache-chunkp.json

# 运行记录（每次跑的完整日志 + meta）—— 量可能大，不进仓库
tools/_runs/

# 句子向量缓存：**派生物，一条命令可重建**（python tools/build-sentences.py，113 秒）。
# 79 MB —— 比语料那三个已跟踪的缓存（各 8.7 MB）大一个量级，而按内容锚（stamp + 逐条 hash）
# 重建时不会静默错位，所以没有"必须随仓库走"的理由。
tools/_sentence_vecs.json
